<%- include('../partials/headHtml')%>
<body class="bg-slate-50/50 min-h-screen flex flex-col font-sans">
    <%- include('../partials/header')%>
    <main class="flex-grow container mx-auto px-6 py-12">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-8">Available Homes</h1>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <% homes.forEach((home) => {%>
                <%- include('../partials/homeList', {home: home})%>
                    <a href="/user/homeList/<%= home._id%>" class="block mt-3 px-5">
                        <button class="w-full bg-slate-800 hover:bg-slate-900 text-white py-2.5 rounded-xl font-semibold transition cursor-pointer shadow-xs text-sm">View Details</button>
                    </a>
                    <div class="mt-2 px-5 pb-5">
                        <div class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-rose-50 hover:bg-rose-100 border border-rose-100 text-rose-600 rounded-xl transition duration-200 cursor-pointer text-sm">
                            <%- include('../partials/favourite', {home})%>
                        </div>
                    </div>
                </li>
            <%});%>
        </ul>
    </main>
    <%- include('../partials/footer')%>
</body>
</html>