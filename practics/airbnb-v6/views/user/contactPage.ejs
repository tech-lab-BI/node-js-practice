<%- include('../partials/headHtml')%>
  <body class="bg-slate-50/50 min-h-screen flex flex-col font-sans">
    <%- include('../partials/header')%>
    <main class="grow container mx-auto px-6 py-12 flex items-center justify-center">
      <div class="max-w-md w-full bg-white rounded-2xl border border-slate-100 shadow-xl p-8">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-6 text-center">Contact Us</h2>
        <form action="/admin/submit" method="POST" class="space-y-5">
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">NAME</label>
            <input type="text" id="name" name="name" placeholder="Enter your name" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium" required />
          </div>
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">EMAIL</label>
            <input type="email" id="email" name="email" placeholder="abc@gmail.com" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium" required />
          </div>
          <button type="submit" class="w-full px-4 py-3 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-xl transition cursor-pointer text-sm shadow-sm shadow-rose-100">
            Submit
          </button>
        </form>
      </div>
    </main>
    <%- include('../partials/footer')%>
  </body>
</html>