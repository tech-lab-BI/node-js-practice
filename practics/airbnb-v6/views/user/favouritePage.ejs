<%- include('../partials/headHtml')%>
<body class="bg-slate-50/50 min-h-screen flex flex-col font-sans">
    <%- include('../partials/header')%>
    <main class="flex-grow container mx-auto px-6 py-12">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-8">My Favourite Homes</h1>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <% homes.forEach((home) => {%>
                <%- include('../partials/homeList', {home: home})%>
                    <form action="/user/deleteFav/<%=home._id%>" method="POST" class="mt-3 px-5">
                        <button class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-xl font-semibold transition cursor-pointer text-sm">Remove from favourite</button>
                    </form>
                    <a href="#" class="block mt-2 px-5 pb-5">
                        <button class="w-full bg-rose-500 hover:bg-rose-600 text-white py-2.5 rounded-xl font-semibold transition cursor-pointer shadow-xs text-sm">Book Now</button>
                    </a>
                    </div>
                </li>
            <%});%>
        </ul>
    </main>
    <%- include('../partials/footer')%>
</body>
</html>