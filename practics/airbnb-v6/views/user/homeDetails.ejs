<%- include('../partials/headHtml')%>

<body class="bg-slate-50/50 min-h-screen flex flex-col font-sans">
  <%- include('../partials/header')%>

  <main class="flex-grow max-w-7xl mx-auto px-6 py-12 w-full flex items-center justify-center">

    <div class="bg-white rounded-3xl border border-slate-100 shadow-xl overflow-hidden max-w-5xl w-full">

      <div class="grid lg:grid-cols-2 gap-0">

        <!-- Image -->
        <div class="p-6 sm:p-8 lg:p-10 flex items-center justify-center">
          <div class="w-full aspect-[4/3] bg-slate-50 rounded-2xl overflow-hidden flex items-center justify-center border border-slate-100 shadow-xs">
            <img
              src="<%= home.photo %>"
              alt="<%= home.houseName %>"
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-102"
            >
          </div>
        </div>

        <!-- Details -->
        <div class="p-8 sm:p-10 lg:p-12 flex flex-col justify-between">

          <div>
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-6">
              <%= home.houseName %>
            </h1>

            <div class="grid grid-cols-2 gap-4">

              <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 transition-all hover:bg-white hover:shadow-xs">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">💰 Price</p>
                <p class="text-2xl font-bold text-rose-500">
                  ₹<%= home.price %> <span class="text-xs font-medium text-slate-400">/ night</span>
                </p>
              </div>

              <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 transition-all hover:bg-white hover:shadow-xs">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">⭐ Rating</p>
                <p class="text-xl font-bold text-amber-500 flex items-center gap-1">
                  <%= home.rating %> <span class="text-xs font-medium text-slate-400">/ 5</span>
                </p>
              </div>

              <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 col-span-2 transition-all hover:bg-white hover:shadow-xs">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">📍 Location</p>
                <p class="text-base font-semibold text-slate-700">
                  <%= home.location %>
                </p>
              </div>

              <div class="bg-slate-50 border border-slate-100 rounded-2xl p-4 col-span-2 transition-all hover:bg-white hover:shadow-xs">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">📄 Description</p>
                <p class="text-sm font-normal text-slate-600 leading-relaxed">
                  <%= home.description %>
                </p>
              </div>

            </div>
            
            <div class="mt-4 flex justify-end">
              <a href="/user/homeList/download/<%= home._id %>" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition cursor-pointer">
                <span>📥</span> Download Photo
              </a>
            </div>

          </div>

          <!-- Buttons -->
          <div class="mt-8 flex gap-4">

            <div class="flex-1">
              <div class="w-full bg-rose-50 hover:bg-rose-100 border border-rose-100 text-rose-600 rounded-2xl flex justify-center items-center py-3.5 transition cursor-pointer text-sm font-semibold">
                <%- include('../partials/favourite')%>
              </div>
            </div>

            <button
              class="flex-1 bg-slate-800 hover:bg-slate-900 text-white font-semibold rounded-2xl py-3.5 transition cursor-pointer text-sm shadow-md shadow-slate-100"
            >
              Book Now
            </button>

          </div>

        </div>

      </div>

    </div>

  </main>

  <%- include('../partials/footer')%>
</body>

</html>