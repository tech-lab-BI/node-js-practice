<% if((typeof errorMessage != 'undefined') && errorMessage.length > 0) { %>
    <div class="p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-xl text-rose-800 shadow-xs mb-6">
      <ul class="list-disc pl-5 space-y-1 text-sm font-medium">
        <% errorMessage.forEach(error => {%>
        <li><%= error%></li>
        <%})%>
      </ul>
    </div>
<%}%>