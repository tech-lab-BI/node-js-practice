<%- include('../partials/headHtml')%>
  <body class="bg-slate-50/50 min-h-screen flex flex-col font-sans">
    <%- include('../partials/header')%>
    <main class="flex-grow container mx-auto px-6 py-12 flex items-center justify-center">
      <div class="max-w-md w-full bg-white rounded-2xl border border-slate-100 shadow-xl p-8">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-6 text-center"><%= editing ? "Edit" : "Register"%> Your Home</h2>
        <form action="/admin/<%= editing ? "editHome" : "hostHome" %>" method="POST" class="space-y-4" enctype="multipart/form-data">
          <input type="hidden" name="id" value="<%= editing ? home._id : ''%>">
          <div>
            <label
              for="houseName"
              class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
              >HOUSE NAME</label
            >
            <input
              type="text"
              id="houseName"
              name="houseName"
              value="<%= editing ? home.houseName : ''%>"
              placeholder="Enter your House Name"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
              required
            />
          </div>
          <div>
            <label
              for="price"
              class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
              >PRICE /NIGHT</label
            >
            <input
              type="number"
              id="price"
              name="price"
              value="<%= editing ? home.price : ''%>"
              placeholder="price per night"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
              required
            />
          </div>
          <div>
            <label
              for="location"
              class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
              >LOCATION</label
            >
            <input
              type="text"
              id="location"
              name="location"
              value="<%= editing ? home.location : ''%>"
              placeholder="Your House Location"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
              required
            />
          </div>
          <div>
            <label
              for="rating"
              class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
              >RATING</label
            >
            <input
              type="number"
              id="rating"
              name="rating"
              value="<%= editing ? home.rating : ''%>"
              placeholder="rate your house under 5"
              step="0.1"
              max="5"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
              required
            />
          </div>
          <div>
            <label
              for="photo"
              class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
              >Upload Photo</label
            >
            <input
              type="file"
              id="photo"
              name="photo"
              class="w-full px-4 py-2 border border-slate-200 bg-slate-50 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 file:mr-4 file:py-1.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-white hover:file:bg-slate-900 file:cursor-pointer text-slate-500 text-sm font-medium"
            />
          </div>
          <div>
            <label
              for="desc"
              class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2"
              >DESCRIPTION</label
            >
            <textarea
              type="url"
              id="desc"
              name="description"
              value="<%= editing ? home.description : ''%>"
              placeholder="Enter description about your home"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium min-h-[100px]"
            ><%= editing ? home.description : ''%></textarea>
          </div>
          <button
            type="submit"
            class="w-full px-4 py-3 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-xl transition cursor-pointer text-sm shadow-sm shadow-rose-100"
          >
            <%= editing ? "UPDATE" : "SUBMIT" %>
          </button>
        </form>
      </div>
    </main>
    <%- include('../partials/footer')%>
  </body>
</html>
