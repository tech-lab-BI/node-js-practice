<%- include('../partials/headHtml')%>
  <body class="bg-slate-50/50 min-h-screen flex flex-col font-sans">
    <%- include('../partials/header')%>
    <main class="flex-grow container mx-auto px-6 py-12 flex items-center justify-center">
      <div class="max-w-md w-full bg-white rounded-2xl border border-slate-100 shadow-xl p-8">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-6 text-center">Registration</h2>

        <%- include('../partials/error')%>

        <form action="/signup" method="POST" class="space-y-4">
          <input
            type="text"
            name="fname"
            placeholder="Enter your first name"
            value="<%= typeof oldInput !== 'undefined' ? oldInput.fname : ''%>"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
            required
          />
          <input
            type="text"
            name="lname"
            placeholder="Enter your last name"
            value="<%= typeof oldInput !== 'undefined' ? oldInput.lname : ''%>"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
            required
          />
          <input
            type="email"
            name="email"
            placeholder="abc@test.com"
            value="<%= typeof oldInput !== 'undefined' ? oldInput.email : ''%>"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
            required
          />
          <input
            type="password"
            name="password"
            placeholder="password"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
            required
          />
          <input
            type="password"
            name="confirmPassword"
            placeholder="Re-enter password"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-transparent transition text-slate-800 text-sm font-medium"
            required
          />
          <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">User Type <span class="text-[10px] font-normal lowercase tracking-normal text-slate-400">(default - guest)</span></p>
            <div class="flex gap-6 mt-1">
              <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-700 hover:text-slate-900">
                <input type="radio" name="userType" id="usertype" value="guest" class="accent-rose-500 w-4 h-4 cursor-pointer" <%= typeof oldInput !== 'undefined' && oldInput.userType === 'guest' ? 'checked' : '' %>>
                <span>Guest</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-slate-700 hover:text-slate-900">
                <input type="radio" name="userType" id="usertype" value="host" class="accent-rose-500 w-4 h-4 cursor-pointer" <%= typeof oldInput !== 'undefined' && oldInput.userType === 'host' ? 'checked' : '' %>>
                <span>Host</span>
              </label>
            </div>
          </div>
          
          <div class="flex items-center gap-2 px-1">
            <label class="flex items-center gap-2.5 cursor-pointer text-sm text-slate-600 hover:text-slate-800">
              <input type="checkbox" name="terms" class="accent-rose-500 w-4 h-4 cursor-pointer" required>
              <span>I agree terms & condition.</span>
            </label>
          </div>
          
          <button
            type="submit"
            class="w-full px-4 py-3 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-xl transition cursor-pointer text-sm shadow-sm shadow-rose-100"
          >
            REGISTER
          </button>
        </form>
      </div>
    </main>
    <%- include('../partials/footer')%>
  </body>
</html>