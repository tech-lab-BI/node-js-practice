<%- include('../partials/headHtml')%>
  <body class="bg-gray-50">
    <%- include('../partials/header')%>
    <main class="container mx-auto px-4 py-8">
      <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Your Home</h2>
        <form action="/login" method="POST" class="space-y-4">
          <div>
            <label
              for="userName"
              class="block text-sm font-semibold text-gray-700 mb-2"
              >USER NAME</label
            >
            <input
              type="text"
              id="userName"
              name="username"
              placeholder="Enter your user name"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-600"
              required
            />
          </div>
          <div>
            <label
              for="password"
              class="block text-sm font-semibold text-gray-700 mb-2"
              >PASSWORD</label
            >
            <input
              type="password"
              id="password"
              name="password"
              placeholder="password"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-600"
              required
            />
          </div>
          
          <button
            type="submit"
            class="w-full px-4 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition"
          >
            SIGN-IN
          </button>
        </form>
      </div>
    </main>
    <%- include('../partials/footer')%>
  </body>
</html>
