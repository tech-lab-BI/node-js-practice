<%- include('../partials/headHtml')%>

<body class="bg-linear-to-br from-gray-100 via-gray-50 to-gray-200">
  <%- include('../partials/header')%>

  <main class="max-w-7xl mx-auto px-6 py-12">

    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

      <div class="grid lg:grid-cols-2">

        <!-- Image -->
        <div class="w-500px h-350px mx-auto bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center">
          <img
            src="<%= home.photoUrl %>"
            alt="<%= home.houseName %>"
            class="max-w-full max-h-full object-contain"
          >
        </div>

        <!-- Details -->
        <div class="p-10 flex flex-col justify-between">

          <div>

            <h1 class="text-4xl font-bold text-gray-800 mb-2">
              <%= home.houseName %>
            </h1>

            <div class="grid grid-cols-2 gap-2">

              <div class="bg-gray-100 rounded-xl p-5">
                <p class="text-sm text-gray-500">Price</p>
                <p class="text-2xl font-bold text-green-600">
                  ₹ <%= home.price %>
                </p>
              </div>

              <div class="bg-gray-100 rounded-xl p-5">
                <p class="text-sm text-gray-500">Rating</p>
                <p class="text-2xl font-bold text-yellow-500">
                  ⭐ <%= home.rating %>/5
                </p>
              </div>

              <div class="bg-gray-100 rounded-xl p-5 col-span-2">
                <p class="text-sm text-gray-500">Location</p>
                <p class="text-lg font-semibold text-gray-800">
                  📍 <%= home.location %>
                </p>
              </div>

              <div class="bg-gray-100 rounded-xl p-5 col-span-2">
                <p class="text-sm text-gray-500">Description</p>
                <p class="text-lg font-semibold text-gray-800">
                  <%= home.description %>
                </p>
              </div>

            </div>

          </div>

          <!-- Buttons -->
          <div class="mt-10 flex gap-4">

            <div class="flex-1">
              <div class="w-full bg-red-500 hover:bg-red-600 text-white rounded-xl flex justify-center items-center py-3 transition">
                <%- include('../partials/favourite')%>
              </div>
            </div>

            <button
              class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl py-3 transition shadow-lg"
            >
              Book Now
            </button>

          </div>

        </div>

      </div>

    </div>

  </main>

  <%- include('../partials/footer')%>
</body>

</html>